+}
+
+static void gl_sw_colorspace_hint(pl_swapchain sw,
+                                  const struct pl_color_space *csp)
+{
+    struct priv *p = PL_PRIV(sw);
+
+    pl_mutex_lock(&p->lock);
+    if (csp) {
+        p->hint = *csp;
+        p->has_hint = true;
+    } else {
+        p->has_hint = false;
+    }
+    pl_mutex_unlock(&p->lock);
 }
 
