+        if (vo_android_surface_size(ctx->vo, &w, &h))
+            android_apply_hdr_window(vo_android_native_window(ctx->vo), w, h);
+    }
+
     if (!mpvk_init(vk, ctx, VK_KHR_ANDROID_SURFACE_EXTENSION_NAME))
