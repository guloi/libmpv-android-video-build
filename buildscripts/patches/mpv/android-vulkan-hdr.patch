+// 10bit RGBA 与 BT.2020/PQ 的 dataspace 在旧 NDK 头文件里未必存在，
+// 这里给出兜底定义（数值与 android/hardware_buffer.h、android/data_space.h 一致）。
+#ifndef AHARDWAREBUFFER_FORMAT_R10G10B10A2_UNORM
+#define AHARDWAREBUFFER_FORMAT_R10G10B10A2_UNORM 0x2b
+#endif
+
+#ifndef ADATASPACE_BT2020_PQ
+#define ADATASPACE_BT2020_PQ 163971072
+#endif
+
+// ANativeWindow_setBuffersDataSpace 是 API 28 才导出的符号，而 libmpv 以
+// API 24 为最低版本编译，直接调用会让库在旧系统上加载失败，故用 dlsym 取。
+typedef int32_t (*set_buffers_dataspace_fn)(ANativeWindow *window, int32_t dataSpace);
+
+static void android_set_dataspace(ANativeWindow *window, int32_t dataspace)
+{
+    static set_buffers_dataspace_fn fn;
+    static bool resolved;
+    if (!resolved) {
+        resolved = true;
+        fn = (set_buffers_dataspace_fn)dlsym(RTLD_DEFAULT,
+                                             "ANativeWindow_setBuffersDataSpace");
+    }
+    if (fn)
+        fn(window, dataspace);
+}
+
+// 是否按 HDR 输出，由 --android-vulkan-hdr 决定（播放器在打开 HDR /
+// 杜比视界片源前设置，SDR 片源保持关闭）。
+static bool android_is_hdr(struct ra_ctx *ctx)
+{
+    return ctx->vo && ctx->vo->opts && ctx->vo->opts->android_vulkan_hdr;
+}
+
+// 把原生窗口切成 10bit BT.2020/PQ。Vulkan WSI 会据此为 surface 报出 HDR 的
+// format / colorSpace，libplacebo 才会按 PQ 渲染，Android 显示端也才会把
+// 面板切进 HDR。ANativeWindow_setBuffersGeometry 会把 dataspace 复位成
+// UNKNOWN，所以每次尺寸变化后都要重新下发。
+static void android_apply_hdr_window(ANativeWindow *window, int w, int h)
+{
+    if (!window)
+        return;
+    ANativeWindow_setBuffersGeometry(window, w, h,
+                                     AHARDWAREBUFFER_FORMAT_R10G10B10A2_UNORM);
+    android_set_dataspace(window, ADATASPACE_BT2020_PQ);
+}
+
+// 告诉 libplacebo 交换链的目标色彩空间是 HDR10，vo_gpu_next 会据此挑选
+// HDR 的 surface format 并按 PQ 编码输出。
+static pl_color_space_t android_preferred_csp(struct ra_ctx *ctx)
+{
+    if (!android_is_hdr(ctx))
+        return (pl_color_space_t){0};
+    return pl_color_space_hdr10;
+}
+
+static int android_color_depth(struct ra_ctx *ctx)
+{
+    return android_is_hdr(ctx) ? 10 : -1;
+}
+
 struct priv {
     struct mpvk_ctx vk;
 };
